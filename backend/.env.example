# ---- PostgreSQL (app/database.py) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_travel_planner
DB_USER=postgres
DB_PASSWORD=

# ---- Connection pool (app/database.py) ----
DB_POOL_MIN=2
DB_POOL_MAX=40

# ---- Ollama (app/services/ollama_service.py) ----
OLLAMA_MODEL=llama3.2:latest
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_READ_TIMEOUT=300

# ---- CORS (app/main.py) ----
# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
